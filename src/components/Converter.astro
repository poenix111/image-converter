---
// Client-side batch converter component.
// Features a sidebar configuration pane on the left, a detailed conversion progression list on the right,
// and a manual launch button to trigger the conversion.
---

<div class="converter-app">
  <!-- Top App Bar -->
  <header class="app-bar">
    <div class="app-bar-content">
      <span class="material-symbols-outlined logo-icon">image_converter</span>
      <h1 class="app-title">Antigravity Converter</h1>
    </div>
    <div class="app-bar-actions">
      <button
        id="theme-toggle"
        class="icon-button"
        aria-label="Toggle dark theme"
        title="Toggle theme"
      >
        <span class="material-symbols-outlined">dark_mode</span>
      </button>
    </div>
  </header>

  <main class="app-content">
    <div class="dashboard-layout">
      <!-- Left Column: Sidebar Controls -->
      <aside class="sidebar">
        <!-- Dropzone Card -->
        <div class="card sidebar-card upload-card" id="dropzone">
          <input
            type="file"
            id="file-input"
            multiple
            accept="image/*,.heic,.heif"
            class="hidden-input"
            aria-label="Choose image files to convert"
          />
          <div class="dropzone-content">
            <span class="material-symbols-outlined upload-card-icon">cloud_upload</span>
            <h3 class="upload-card-title">Load Images</h3>
            <p class="upload-card-subtitle">Click or drag files here</p>
          </div>
        </div>

        <!-- Settings Card -->
        <div class="card sidebar-card settings-card">
          <h2 class="sidebar-card-title">Configuration</h2>

          <div class="setting-group">
            <label class="setting-label">Format</label>
            <div class="format-chips" role="radiogroup" aria-label="Target Format">
              <button
                class="format-chip active"
                data-format="image/jpeg"
                role="radio"
                aria-checked="true"
              >
                <span class="material-symbols-outlined chip-icon">check</span>
                <span>JPEG</span>
              </button>
              <button
                class="format-chip"
                data-format="image/webp"
                role="radio"
                aria-checked="false"
              >
                <span class="material-symbols-outlined chip-icon">check</span>
                <span>WEBP</span>
              </button>
              <button
                class="format-chip"
                data-format="image/png"
                role="radio"
                aria-checked="false"
              >
                <span class="material-symbols-outlined chip-icon">check</span>
                <span>PNG</span>
              </button>
            </div>
          </div>

          <div class="setting-group">
            <div class="slider-header">
              <label for="quality-slider" class="setting-label">Quality</label>
              <span id="quality-val" class="slider-value">85%</span>
            </div>
            <input
              type="range"
              id="quality-slider"
              min="10"
              max="100"
              value="85"
              class="slider"
              aria-valuemin="10"
              aria-valuemax="100"
              aria-valuenow="85"
            />
          </div>
        </div>

        <!-- Actions Panel -->
        <div class="card sidebar-card actions-card">
          <button id="btn-convert" class="btn btn-filled action-btn" disabled>
            <span class="material-symbols-outlined btn-icon">play_arrow</span>
            <span>Convert Images</span>
          </button>
          
          <button id="btn-download-zip" class="btn btn-tonal action-btn" disabled>
            <span class="material-symbols-outlined btn-icon">download</span>
            <span>Download ZIP</span>
          </button>
          
          <button id="btn-clear" class="btn btn-text action-btn" disabled>
            <span class="material-symbols-outlined btn-icon">delete_sweep</span>
            <span>Clear Queue</span>
          </button>
        </div>
      </aside>

      <!-- Right Column: Progression List -->
      <section class="main-panel">
        <div class="panel-header">
          <h2 class="panel-title">Progression Queue</h2>
          <span id="summary-text" class="summary-text">No images loaded</span>
        </div>

        <!-- Empty State Placeholder -->
        <div id="queue-empty" class="queue-empty">
          <span class="material-symbols-outlined empty-icon">photo_library</span>
          <p class="empty-title">Queue is empty</p>
          <p class="empty-subtitle">Load files from the sidebar to view conversion progress</p>
        </div>

        <!-- Queue Table Container -->
        <div id="queue-container" class="queue-container hidden">
          <!-- Table Header -->
          <div class="queue-table-header">
            <span class="col-hdr-preview">Preview</span>
            <span class="col-hdr-name">Name</span>
            <span class="col-hdr-size">Size</span>
            <span class="col-hdr-progress">Progress</span>
            <span class="col-hdr-status">Status</span>
            <span class="col-hdr-action"></span>
          </div>
          
          <!-- Scrollable Table Body -->
          <div id="queue-list" class="queue-list"></div>
        </div>

        <!-- Bottom Global Progress Bar -->
        <div id="queue-footer" class="queue-footer hidden">
          <div class="footer-summary">
            <span id="global-status-text">Ready to convert 0 files</span>
            <span id="global-progress-percent">0%</span>
          </div>
          <div class="global-progress-container">
            <div id="global-progress-bar" class="global-progress-bar" style="width: 0%;"></div>
          </div>
        </div>
      </section>
    </div>
  </main>
</div>

<script>
  import JSZip from "jszip";

  // Global variables
  let queue: any[] = [];
  let isConverting = false;
  let activeWorkers = 0;
  let theme = "dark"; // default to dark for premium look

  // DOM Panels & Elements
  const themeToggle = document.getElementById("theme-toggle") as HTMLElement;
  const dropzone = document.getElementById("dropzone") as HTMLElement;
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const qualitySlider = document.getElementById("quality-slider") as HTMLInputElement;
  const qualityVal = document.getElementById("quality-val") as HTMLElement;
  const formatChips = document.querySelectorAll(".format-chip");
  
  const btnConvert = document.getElementById("btn-convert") as HTMLButtonElement;
  const btnDownloadZip = document.getElementById("btn-download-zip") as HTMLButtonElement;
  const btnClear = document.getElementById("btn-clear") as HTMLButtonElement;
  
  const summaryText = document.getElementById("summary-text") as HTMLElement;
  const queueEmpty = document.getElementById("queue-empty") as HTMLElement;
  const queueContainer = document.getElementById("queue-container") as HTMLElement;
  const queueList = document.getElementById("queue-list") as HTMLElement;
  const queueFooter = document.getElementById("queue-footer") as HTMLElement;
  const globalProgressBar = document.getElementById("global-progress-bar") as HTMLElement;
  const globalProgressPercent = document.getElementById("global-progress-percent") as HTMLElement;
  const globalStatusText = document.getElementById("global-status-text") as HTMLElement;

  // Active configurations
  let targetFormat = "image/jpeg";
  let quality = 0.85;
  let maxConcurrency = 2; // Default concurrency for optimal CPU usage
  let generatedZipUrl: string | null = null;
  let currentZipName = "converted_images.zip";

  // Initialize Theme
  if (
    window.matchMedia &&
    window.matchMedia("(prefers-color-scheme: light)").matches
  ) {
    theme = "light";
  }

  // Set theme class initially
  if (theme === "dark") {
    document.documentElement.classList.add("dark-theme");
    themeToggle.querySelector(".material-symbols-outlined")!.textContent =
      "light_mode";
  } else {
    document.documentElement.classList.remove("dark-theme");
    themeToggle.querySelector(".material-symbols-outlined")!.textContent =
      "dark_mode";
  }

  // Event Listeners for Theme
  themeToggle.addEventListener("click", () => {
    if (document.documentElement.classList.contains("dark-theme")) {
      document.documentElement.classList.remove("dark-theme");
      themeToggle.querySelector(".material-symbols-outlined")!.textContent =
        "dark_mode";
      localStorage.setItem("theme", "light");
    } else {
      document.documentElement.classList.add("dark-theme");
      themeToggle.querySelector(".material-symbols-outlined")!.textContent =
        "light_mode";
      localStorage.setItem("theme", "dark");
    }
  });

  // Target Format Chips
  formatChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      if (isConverting) return;
      formatChips.forEach((c) => {
        c.classList.remove("active");
        c.setAttribute("aria-checked", "false");
      });
      chip.classList.add("active");
      chip.setAttribute("aria-checked", "true");
      targetFormat = (chip as HTMLElement).dataset.format || "image/jpeg";
    });
  });

  // Slider controls
  qualitySlider.addEventListener("input", (e) => {
    const val = (e.target as HTMLInputElement).value;
    qualityVal.textContent = `${val}%`;
    quality = parseInt(val) / 100;
  });

  // File Upload Handlers
  dropzone.addEventListener("click", () => {
    if (isConverting) return;
    fileInput.click();
  });

  dropzone.addEventListener("dragover", (e) => {
    e.preventDefault();
    if (isConverting) return;
    dropzone.classList.add("dragover");
  });

  ["dragleave", "dragend"].forEach((type) => {
    dropzone.addEventListener(type, () => {
      dropzone.classList.remove("dragover");
    });
  });

  dropzone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("dragover");
    if (isConverting) return;
    if (e.dataTransfer && e.dataTransfer.files.length > 0) {
      processFiles(e.dataTransfer.files);
    }
  });

  fileInput.addEventListener("change", (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      processFiles(target.files);
      target.value = ""; // Reset to allow re-uploading same files
    }
  });

  // Actions click handlers
  btnConvert.addEventListener("click", () => {
    if (isConverting) {
      stopConversion();
    } else {
      startConversion();
    }
  });

  btnDownloadZip.addEventListener("click", () => {
    if (generatedZipUrl) {
      const a = document.createElement("a");
      a.href = generatedZipUrl;
      a.download = currentZipName;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }
  });

  btnClear.addEventListener("click", () => {
    if (isConverting) return;
    // Revoke previous URLs
    queue.forEach(item => {
      if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
      if (item.thumbnailUrl) URL.revokeObjectURL(item.thumbnailUrl);
    });
    queue = [];
    
    if (generatedZipUrl) {
      URL.revokeObjectURL(generatedZipUrl);
      generatedZipUrl = null;
    }
    
    renderQueueList();
  });

  // Core Processing Logic
  function processFiles(filesList: FileList) {
    // Add loaded files to queue
    const newItems = Array.from(filesList).map(file => {
      const isHeic = file.name.toLowerCase().endsWith(".heic") || file.name.toLowerCase().endsWith(".heif");
      let url = null;
      if (!isHeic) {
        url = URL.createObjectURL(file);
      }
      return {
        id: crypto.randomUUID(),
        file: file,
        name: file.name,
        originalSize: file.size,
        status: "pending", // 'pending', 'converting', 'success', 'failed'
        progress: 0,
        convertedBlob: null,
        convertedName: null,
        convertedSize: null,
        convertedUrl: null,
        thumbnailUrl: url,
        isHeic: isHeic,
        error: null
      };
    });

    queue.push(...newItems);
    
    // Revoke zip url if queue changes
    if (generatedZipUrl) {
      URL.revokeObjectURL(generatedZipUrl);
      generatedZipUrl = null;
    }

    renderQueueList();
  }

  function removeQueueItem(id: string) {
    if (isConverting) return;
    const idx = queue.findIndex(item => item.id === id);
    if (idx !== -1) {
      const item = queue[idx];
      if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
      if (item.thumbnailUrl) URL.revokeObjectURL(item.thumbnailUrl);
      queue.splice(idx, 1);
      
      if (generatedZipUrl) {
        URL.revokeObjectURL(generatedZipUrl);
        generatedZipUrl = null;
      }
      
      renderQueueList();
    }
  }

  function renderQueueList() {
    queueList.replaceChildren();

    if (queue.length === 0) {
      queueEmpty.classList.remove("hidden");
      queueContainer.classList.add("hidden");
      queueFooter.classList.add("hidden");
      
      btnConvert.disabled = true;
      btnDownloadZip.disabled = true;
      btnClear.disabled = true;
      summaryText.textContent = "No images loaded";
      return;
    }

    queueEmpty.classList.add("hidden");
    queueContainer.classList.remove("hidden");
    queueFooter.classList.remove("hidden");

    btnConvert.disabled = isConverting ? false : false; // handled in updateGlobalUI
    btnClear.disabled = isConverting;
    btnDownloadZip.disabled = !generatedZipUrl;

    queue.forEach(item => {
      // Row is structured using CSS grid matching the headers
      const row = document.createElement("div");
      row.className = `queue-table-row ${item.status}`;
      row.id = `item-${item.id}`;

      // Column 1: Preview
      const previewCol = document.createElement("div");
      previewCol.className = "col-preview";
      
      if (item.thumbnailUrl) {
        const img = document.createElement("img");
        img.src = item.thumbnailUrl;
        img.alt = "Thumbnail";
        previewCol.appendChild(img);
      } else {
        const span = document.createElement("span");
        span.className = "material-symbols-outlined preview-icon";
        span.textContent = item.isHeic ? "image_search" : "image";
        previewCol.appendChild(span);
      }

      // Column 2: Name
      const nameCol = document.createElement("div");
      nameCol.className = "col-name";
      nameCol.title = item.name;
      nameCol.textContent = item.name;

      // Column 3: Size
      const sizeCol = document.createElement("div");
      sizeCol.className = "col-size";
      
      const sizeSpan = document.createElement("span");
      sizeSpan.textContent = formatBytes(item.originalSize);
      sizeCol.appendChild(sizeSpan);

      if (item.convertedSize) {
        const arrow = document.createElement("span");
        arrow.className = "details-arrow";
        arrow.textContent = " → ";
        sizeCol.appendChild(arrow);

        const convSpan = document.createElement("span");
        convSpan.className = "details-converted";
        convSpan.textContent = `${formatBytes(item.convertedSize)}`;
        sizeCol.appendChild(convSpan);
      }

      // Column 4: Progress Bar
      const progressCol = document.createElement("div");
      progressCol.className = "col-progress";
      
      const barContainer = document.createElement("div");
      barContainer.className = "item-progress-bar-container";
      const bar = document.createElement("div");
      bar.className = "item-progress-bar";
      bar.style.width = `${item.progress}%`;
      barContainer.appendChild(bar);
      progressCol.appendChild(barContainer);

      // Column 5: Status Chip
      const statusCol = document.createElement("div");
      statusCol.className = "col-status";

      const chip = document.createElement("span");
      chip.className = `status-chip ${item.status}`;
      chip.textContent = getStatusLabel(item);
      statusCol.appendChild(chip);

      // Column 6: Action Button
      const actionCol = document.createElement("div");
      actionCol.className = "col-action";
      
      if (!isConverting) {
        const btnRemove = document.createElement("button");
        btnRemove.className = "icon-button item-remove-btn";
        btnRemove.title = "Remove file";
        btnRemove.setAttribute("aria-label", `Remove ${item.name}`);
        btnRemove.innerHTML = '<span class="material-symbols-outlined">close</span>';
        btnRemove.addEventListener("click", (e) => {
          e.stopPropagation();
          removeQueueItem(item.id);
        });
        actionCol.appendChild(btnRemove);
      }

      row.appendChild(previewCol);
      row.appendChild(nameCol);
      row.appendChild(sizeCol);
      row.appendChild(progressCol);
      row.appendChild(statusCol);
      row.appendChild(actionCol);
      
      queueList.appendChild(row);
    });

    updateGlobalUI();
  }

  function getStatusLabel(item: any): string {
    if (item.status === "pending") return "Ready";
    if (item.status === "converting") return `Running (${item.progress}%)`;
    if (item.status === "success") return "Done";
    if (item.status === "failed") return `Failed: ${item.error || 'error'}`;
    return "Ready";
  }

  // Update a single item DOM node quickly without rebuilding the whole list
  function updateItemUIState(item: any) {
    const row = document.getElementById(`item-${item.id}`);
    if (!row) return;

    row.className = `queue-table-row ${item.status}`;
    
    // Update thumbnail if set
    const img = row.querySelector(".col-preview img") as HTMLImageElement;
    if (img && item.thumbnailUrl) {
      img.src = item.thumbnailUrl;
    } else if (!img && item.thumbnailUrl) {
      const previewDiv = row.querySelector(".col-preview") as HTMLElement;
      previewDiv.replaceChildren();
      const newImg = document.createElement("img");
      newImg.src = item.thumbnailUrl;
      newImg.alt = "Thumbnail";
      previewDiv.appendChild(newImg);
    }

    // Update converted details text in the Size column
    const sizeCol = row.querySelector(".col-size") as HTMLElement;
    if (sizeCol && item.convertedSize) {
      sizeCol.replaceChildren();
      
      const sizeSpan = document.createElement("span");
      sizeSpan.textContent = formatBytes(item.originalSize);
      sizeCol.appendChild(sizeSpan);
      
      const arrowSpan = document.createElement("span");
      arrowSpan.className = "details-arrow";
      arrowSpan.textContent = " → ";
      sizeCol.appendChild(arrowSpan);

      const convSizeSpan = document.createElement("span");
      convSizeSpan.className = "details-converted";
      convSizeSpan.textContent = `${formatBytes(item.convertedSize)}`;
      sizeCol.appendChild(convSizeSpan);
    }

    // Update progress bar width
    const progressBar = row.querySelector(".item-progress-bar") as HTMLElement;
    if (progressBar) {
      progressBar.style.width = `${item.progress}%`;
    }

    // Update Status Chip
    const chip = row.querySelector(".col-status .status-chip") as HTMLElement;
    if (chip) {
      chip.className = `status-chip ${item.status}`;
      chip.textContent = getStatusLabel(item);
    }

    updateGlobalUI();
  }

  function updateGlobalUI() {
    const total = queue.length;
    const pending = queue.filter(i => i.status === "pending").length;
    const converting = queue.filter(i => i.status === "converting").length;
    const success = queue.filter(i => i.status === "success").length;
    const failed = queue.filter(i => i.status === "failed").length;
    const completed = success + failed;

    // Calculate average progress of all items for a smooth global bar transition
    const totalProgress = queue.reduce((sum, item) => sum + item.progress, 0);
    const globalProgress = total > 0 ? Math.round(totalProgress / total) : 0;

    // Toggle configuration disable state
    qualitySlider.disabled = isConverting;
    formatChips.forEach(chip => {
      const htmlChip = chip as HTMLElement;
      if (isConverting) {
        htmlChip.setAttribute("disabled", "true");
        htmlChip.style.opacity = "0.5";
        htmlChip.style.pointerEvents = "none";
      } else {
        htmlChip.removeAttribute("disabled");
        htmlChip.style.opacity = "1";
        htmlChip.style.pointerEvents = "auto";
      }
    });

    btnClear.disabled = isConverting || total === 0;
    btnDownloadZip.disabled = !generatedZipUrl || isConverting;

    // Update Global Progress Bar
    globalProgressBar.style.width = `${globalProgress}%`;
    globalProgressPercent.textContent = `${globalProgress}%`;

    if (isConverting) {
      btnConvert.classList.remove("btn-filled");
      btnConvert.classList.add("btn-tonal");
      btnConvert.querySelector(".material-symbols-outlined")!.textContent = "stop";
      btnConvert.querySelector("span:not(.material-symbols-outlined)")!.textContent = "Stop Conversion";
      btnConvert.disabled = false;
      
      summaryText.textContent = `Converting: ${completed}/${total} completed`;
      globalStatusText.textContent = `Converting ${completed} of ${total} images...`;
    } else {
      btnConvert.classList.add("btn-filled");
      btnConvert.classList.remove("btn-tonal");
      btnConvert.querySelector(".material-symbols-outlined")!.textContent = "play_arrow";
      btnConvert.querySelector("span:not(.material-symbols-outlined)")!.textContent = "Convert Images";
      
      // Disable convert button if no pending images left
      btnConvert.disabled = pending === 0;

      if (total === 0) {
        summaryText.textContent = "No images loaded";
        globalStatusText.textContent = "No images loaded";
      } else if (success === total) {
        summaryText.textContent = `Completed all ${total} images`;
        globalStatusText.textContent = `Successfully completed all ${total} images!`;
      } else if (completed > 0) {
        summaryText.textContent = `Completed ${completed} of ${total} (${failed} failed)`;
        globalStatusText.textContent = `Conversion run finished. ${success} succeeded, ${failed} failed.`;
      } else {
        summaryText.textContent = `${total} images loaded, ready to convert`;
        globalStatusText.textContent = `${total} images ready. Click "Convert Images" in the sidebar.`;
      }
    }
  }

  async function startConversion() {
    if (queue.length === 0) return;
    
    isConverting = true;
    activeWorkers = 0;
    
    // Revoke previous ZIP URL when starting new conversion run
    if (generatedZipUrl) {
      URL.revokeObjectURL(generatedZipUrl);
      generatedZipUrl = null;
    }

    // Reset failed/success items so they are re-processed
    queue.forEach(item => {
      if (item.status === "failed" || item.status === "success") {
        item.status = "pending";
        item.progress = 0;
        item.error = null;
        if (item.convertedUrl) URL.revokeObjectURL(item.convertedUrl);
        item.convertedBlob = null;
        item.convertedSize = null;
      }
    });

    renderQueueList();
    processQueueNext();
  }

  function stopConversion() {
    isConverting = false;
    queue.forEach(item => {
      if (item.status === "converting") {
        item.status = "pending";
        item.progress = 0;
      }
    });
    renderQueueList();
  }

  function processQueueNext() {
    if (!isConverting) return;

    const pendingItems = queue.filter(item => item.status === "pending");
    
    if (pendingItems.length === 0 && activeWorkers === 0) {
      // Conversions done, generate zip!
      finalizeConversion();
      return;
    }

    while (activeWorkers < maxConcurrency && pendingItems.length > 0) {
      const nextItem = pendingItems.shift()!;
      nextItem.status = "converting";
      nextItem.progress = 5;
      activeWorkers++;
      
      runImageConversion(nextItem).then(() => {
        activeWorkers--;
        processQueueNext();
      });

      updateItemUIState(nextItem);
    }
  }

  async function runImageConversion(item: any) {
    const ext = getExtensionForMime(targetFormat);
    const baseNameWithoutExt = item.name.substring(0, item.name.lastIndexOf(".")) || item.name;
    item.convertedName = `${baseNameWithoutExt}.${ext}`;

    try {
      let sourceBlob = item.file;
      
      // Step 1: Decode HEIC/HEIF if applicable
      if (item.isHeic) {
        item.progress = 20;
        updateItemUIState(item);

        try {
          const heicToModule = await import("heic-to");
          const heicTo = heicToModule.heicTo || heicToModule.default || heicToModule;

          const convResult = await heicTo({
            blob: item.file,
            type: (targetFormat === "image/webp" ? "image/jpeg" : targetFormat) as any,
            quality: quality
          });

          sourceBlob = convResult;
          item.progress = 60;
          updateItemUIState(item);
        } catch (err) {
          console.error("HEIC decoding error:", err);
          const errorMsg = (err && typeof err === "object" && "message" in err) ? String((err as any).message) : "HEIC decoding failed";
          throw new Error(errorMsg);
        }
      }

      // Step 2: Convert Format / Adjust Quality using Canvas
      const sourceMime = sourceBlob.type;
      
      if (sourceMime === targetFormat && !item.isHeic && quality === 1.0) {
        item.convertedBlob = sourceBlob;
      } else {
        item.progress = 75;
        updateItemUIState(item);

        const canvasBlob = await convertViaCanvas(sourceBlob, targetFormat, quality);
        item.convertedBlob = canvasBlob;
      }

      item.convertedSize = item.convertedBlob.size;
      item.convertedUrl = URL.createObjectURL(item.convertedBlob);
      item.status = "success";
      item.progress = 100;
    } catch (e: any) {
      console.error(e);
      item.status = "failed";
      item.error = e.message || "Conversion failed";
      item.progress = 0;
    }

    updateItemUIState(item);
  }

  // Finalize conversion and generate Zip
  async function finalizeConversion() {
    isConverting = false;
    globalStatusText.textContent = "Packaging ZIP file...";
    
    const successItems = queue.filter(item => item.status === "success" && item.convertedBlob);

    if (successItems.length > 0) {
      try {
        const zip = new JSZip();
        
        successItems.forEach(item => {
          const cleanName = item.convertedName.replace(/[/\\]/g, "_");
          zip.file(cleanName, item.convertedBlob);
        });

        const zipBlob = await zip.generateAsync({ type: "blob" });
        generatedZipUrl = URL.createObjectURL(zipBlob);

        // Generate dynamic filename containing current local date & time
        const now = new Date();
        const year = now.getFullYear();
        const month = String(now.getMonth() + 1).padStart(2, "0");
        const day = String(now.getDate()).padStart(2, "0");
        const hours = String(now.getHours()).padStart(2, "0");
        const minutes = String(now.getMinutes()).padStart(2, "0");
        const seconds = String(now.getSeconds()).padStart(2, "0");
        currentZipName = `converted_${year}-${month}-${day}_${hours}-${minutes}-${seconds}.zip`;

        // Auto trigger download
        const a = document.createElement("a");
        a.href = generatedZipUrl;
        a.download = currentZipName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      } catch (err: any) {
        console.error("ZIP Generation error:", err);
        const errorMsg = (err && typeof err === "object" && "message" in err) ? String(err.message) : String(err);
        globalStatusText.textContent = `Packaging failed: ${errorMsg}`;
      }
    }

    renderQueueList();
  }

  // Canvas API Conversion Helper
  // Implements wide color space preservation (Display-P3) to prevent desaturated or shifted color tones.
  async function convertViaCanvas(
    blob: Blob,
    mimeType: string,
    qualityVal: number,
  ): Promise<Blob> {
    try {
      // Step A: Decode image without color space conversion to retain raw color profiles
      const imageBitmap = await createImageBitmap(blob, { colorSpaceConversion: "none" });

      const canvas = document.createElement("canvas");
      canvas.width = imageBitmap.width;
      canvas.height = imageBitmap.height;

      // Step B: Set canvas to Display-P3 if supported to maintain wide-gamut vibrancy
      let ctx: CanvasRenderingContext2D | null = null;
      try {
        ctx = canvas.getContext("2d", { colorSpace: "display-p3" }) as CanvasRenderingContext2D | null;
      } catch (e) {
        ctx = canvas.getContext("2d") as CanvasRenderingContext2D | null;
      }

      if (!ctx) {
        throw new Error("Unable to create canvas context");
      }

      ctx.drawImage(imageBitmap, 0, 0);

      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (outBlob) => {
            imageBitmap.close(); // clean up resources immediately
            if (outBlob) {
              resolve(outBlob);
            } else {
              reject(new Error("Canvas export to blob failed"));
            }
          },
          mimeType,
          qualityVal,
        );
      });
    } catch (err) {
      console.warn("createImageBitmap failed, falling back to standard Image loader:", err);
      
      // Fallback for older browsers or unsupported files
      return new Promise((resolve, reject) => {
        const img = new Image();
        const url = URL.createObjectURL(blob);

        img.onload = () => {
          URL.revokeObjectURL(url);

          const canvas = document.createElement("canvas");
          canvas.width = img.naturalWidth;
          canvas.height = img.naturalHeight;

          let ctx: CanvasRenderingContext2D | null = null;
          try {
            ctx = canvas.getContext("2d", { colorSpace: "display-p3" }) as CanvasRenderingContext2D | null;
          } catch (e) {
            ctx = canvas.getContext("2d") as CanvasRenderingContext2D | null;
          }
          
          if (!ctx) {
            reject(new Error("Unable to create canvas context"));
            return;
          }

          ctx.drawImage(img, 0, 0);

          canvas.toBlob(
            (outBlob) => {
              if (outBlob) {
                resolve(outBlob);
              } else {
                reject(new Error("Canvas export to blob failed"));
              }
            },
            mimeType,
            qualityVal,
          );
        };

        img.onerror = () => {
          URL.revokeObjectURL(url);
          reject(new Error("Failed to load image file into canvas"));
        };

        img.src = url;
      });
    }
  }

  // File size formatter
  function formatBytes(bytes: number, decimals = 2) {
    if (bytes === 0) return "0 Bytes";
    const k = 1024;
    const dm = decimals < 0 ? 0 : decimals;
    const sizes = ["Bytes", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + " " + sizes[i];
  }

  // Utility to map mime back to simple extensions
  function getExtensionForMime(mime: string) {
    if (mime === "image/jpeg") return "jpg";
    if (mime === "image/webp") return "webp";
    if (mime === "image/png") return "png";
    return "jpg";
  }
</script>

